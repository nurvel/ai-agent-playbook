{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"],
      "lifecycle": "lazy"
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest",
        "--api-key",
        "${CONTEXT7_API_KEY}"
      ]
    },
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "codex": {
      "command": "codex",
      "args": ["mcp-server"]
    },
    "gsc": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "suganthan-gsc-mcp@latest"],
      "env": {
        "GSC_AUTH_MODE": "oauth",
        "GSC_OAUTH_SECRETS_FILE": "${GSC_OAUTH_SECRETS_FILE}",
        "GSC_SITE_URL": "${GSC_SITE_URL}"
      }
    }
  }
}
