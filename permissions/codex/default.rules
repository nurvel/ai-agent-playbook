# Command rules for Codex (~/.codex/rules/). Decisions: allow | prompt | forbidden.
# Mirrors the ask/deny policy in ../claude/settings.json.

prefix_rule(
    pattern = ["git", "push", ["--force", "-f"]],
    decision = "forbidden",
    justification = "Force push rewrites shared history.",
)
prefix_rule(
    pattern = ["rm", ["-rf", "-fr", "-Rf", "-fR"]],
    decision = "forbidden",
    justification = "Forced recursive delete; remove specific paths instead.",
)
prefix_rule(pattern = ["rm", ["-r", "-R", "--recursive"]], decision = "prompt")

# Outward-facing or remote-state commands.
prefix_rule(pattern = ["git", ["push", "remote"]], decision = "prompt")
prefix_rule(pattern = [["npm", "yarn", "pnpm"], "publish"], decision = "prompt")
prefix_rule(pattern = ["docker", "push"], decision = "prompt")
prefix_rule(
    pattern = [["kubectl", "vercel", "aws", "gcloud", "ssh", "scp", "rsync", "curl", "wget"]],
    decision = "prompt",
)

# Read-only GitHub CLI. Other gh commands fall back to approval_policy; a broader
# "prompt" rule would override this, because the strictest matching rule wins.
prefix_rule(
    pattern = ["gh", ["pr", "issue", "run"], ["view", "list", "diff", "checks", "status"]],
    decision = "allow",
)
